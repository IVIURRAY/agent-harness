# Copy to ~/.env (or ./.env). The harness loads both; keys are read by the SDKs and never enter the prompt.

# --- Option A: OpenRouter, free model (no cost) ---
OPENROUTER_API_KEY=sk-or-...
# HARNESS_PROVIDER=openrouter          # auto-picked when only OPENROUTER_API_KEY is set
# HARNESS_MODEL=<id>:free              # omit to auto-select; list options: python -m harness.providers.openrouter_models
# HARNESS_FALLBACK_MODELS=a:free,b:free

# --- Option B: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# HARNESS_MODEL=claude-sonnet-5-5
# HARNESS_EFFORT=medium

# Compact the conversation when the context reaches this many tokens (set low, e.g. 4000, to watch it)
HARNESS_COMPACT_AT_TOKENS=120000
HARNESS_MAX_STEPS=40
