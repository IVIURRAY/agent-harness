# Copy to ~/.env (or ./.env). The harness loads both; the key is read by the SDK and never enters the prompt.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
HARNESS_MODEL=claude-sonnet-5-5
HARNESS_EFFORT=medium
# Compact the conversation when the context reaches this many tokens (set low, e.g. 4000, to see compaction happen)
HARNESS_COMPACT_AT_TOKENS=120000
HARNESS_MAX_STEPS=40
